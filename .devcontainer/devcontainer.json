{
  "name": "Windows Python Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3-windowsservercore",

  // This command runs after the Codespace is created
  // It will automatically install all your needed libraries, including pywin32
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",

  // Optional: Configure VS Code settings for this Codespace
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.windows": "PowerShell"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}